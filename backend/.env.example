# Database connection (supports postgresql://, postgres://, or postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ycombinator_db

# Sentence Transformer embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Optional Search & Crawling settings
SEARXNG_URL=http://localhost:8080/search
SIMILARITY_FALLBACK_THRESHOLD=0.35
CRAWL_TIMEOUT_SECONDS=30

